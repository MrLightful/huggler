      "html": "<button class=\"ds-send\" aria-label=\"Send\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></button>",
      "css": ".ds-send{color-scheme:dark;display:inline-grid;place-items:center;width:2rem;height:2rem;border:0;padding:0;border-radius:999px;background:#fafafa;color:#171717}.ds-send:hover{background:#e5e5e5}.ds-send:active{background:#d4d4d4}.ds-send:focus-visible{outline:2px solid #d4d4d4;outline-offset:2px}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Compact secondary action with a transparent resting surface.",
      "html": "<button class=\"ds-ghost\">Refresh</button>",
      "css": ".ds-ghost{color-scheme:light dark;font-family:\"DM Sans\",system-ui,sans-serif;color:light-dark(#0a0a0a, #fafafa);border-radius:6px;border:0;background:transparent;height:1.5rem;padding:0 .375rem;font-size:.875rem}.ds-ghost:hover{background:light-dark(#eaeaea, #3a3632)}.ds-ghost:active{background:light-dark(#dfdfdf, #302d2a)}.ds-ghost:focus-visible{outline:2px solid light-dark(#0a0a0a, #d4d4d4);outline-offset:2px}"
    },
    {
      "name": "Settings field",
      "kind": "input",
      "refersTo": "settings-input",
      "description": "A compact label and a bordered GPUI field.",
      "html": "<label class=\"ds-field\">Custom executable<input class=\"ds-field-input\" placeholder=\"Automatic\"></label>",
      "css": ".ds-field{color-scheme:light dark;font-family:\"DM Sans\",system-ui,sans-serif;color:light-dark(#0a0a0a, #fafafa);display:grid;gap:0.25rem;font-size:.8125rem;font-weight:500}.ds-field-input{font-family:\"DM Sans\",system-ui,sans-serif;border-radius:6px;box-sizing:border-box;height:2rem;padding:0 12px;color:light-dark(#0a0a0a, #fafafa);background:light-dark(#f9f9f9, #171615);border:1px solid light-dark(#e5e5e5, #262626);box-shadow:0 1px 2px rgba(0, 0, 0, 0.05);font-size:.875rem}.ds-field-input::placeholder{color:light-dark(#606060, #aaa49e)}.ds-field-input:focus-visible{border-color:light-dark(#0a0a0a, #d4d4d4);outline:none}.ds-field-input:disabled{background:light-dark(#efefef, #2c2926)}"
    },
    {
      "name": "Conversation navigation",
      "kind": "nav",
      "refersTo": "conversation-row",
      "description": "A compact status header above the selected conversation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Conversations\"><button class=\"ds-nav-group\"><span class=\"ds-nav-icon\" aria-hidden=\"true\">→</span> Ready (1) <svg aria-hidden=\"true\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></button><button class=\"ds-nav-row\" aria-current=\"page\" title=\"Review parser changes · Ready\">Review parser changes</button></nav>",
      "css": ".ds-nav{color-scheme:light dark;font-family:\"DM Sans\",system-ui,sans-serif;color:light-dark(#0a0a0a, #fafafa);display:grid;gap:.25rem;background:light-dark(#f4f4f4, #201e1c);padding:.5rem}.ds-nav-group,.ds-nav-row{font-family:\"DM Sans\",system-ui,sans-serif;border-radius:6px;border:0;min-height:1.5rem;text-align:left;padding:0 .5rem}.ds-nav-group{color:light-dark(#606060, #aaa49e);background:transparent;font-size:.75rem;font-weight:600}.ds-nav-group svg{vertical-align:middle}.ds-nav-icon{color:light-dark(#177243, #63ce91)}.ds-nav-group:hover{background:light-dark(#eaeaea, #3a3632)}.ds-nav-row{color:light-dark(#0a0a0a, #fafafa);background:light-dark(#dfdfdf, #3a3632);font-size:.8125rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-nav-group:focus-visible,.ds-nav-row:focus-visible{outline:2px solid light-dark(#0a0a0a, #d4d4d4);outline-offset:2px}"
    },
    {
      "name": "Attachment chip",
      "kind": "chip",
      "refersTo": "attachment-chip",
      "description": "An outlined file control with an icon and a bounded filename.",
      "html": "<button class=\"ds-chip\" title=\"notes.md\"><svg aria-hidden=\"true\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6\"/></svg><span class=\"ds-chip-label\">notes.md</span></button>",
      "css": ".ds-chip{color-scheme:light dark;font-family:\"DM Sans\",system-ui,sans-serif;color:light-dark(#0a0a0a, #fafafa);display:inline-flex;align-items:center;gap:.25rem;height:1.25rem;padding:0 .375rem;border:1px solid light-dark(#dfdfdf, #34312e);border-radius:5px;background:transparent;font-size:.8125rem}.ds-chip svg{color:light-dark(#606060, #aaa49e);flex:none}.ds-chip-label{max-width:12rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-chip:hover{background:light-dark(#eaeaea, #3a3632)}.ds-chip:active{background:light-dark(#dfdfdf, #302d2a)}.ds-chip:focus-visible{outline:2px solid light-dark(#0a0a0a, #d4d4d4);outline-offset:2px}"
    },
    {
      "name": "Settings group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "A single frame around related destinations with hairline dividers.",
      "html": "<section class=\"ds-group\" aria-label=\"Preferences\"><button class=\"ds-group-row\"><span class=\"ds-group-copy\">General<small>Message and notification preferences</small></span><svg aria-hidden=\"true\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></button><button class=\"ds-group-row\"><span class=\"ds-group-copy\">Appearance<small>System, Light, or Dark</small></span><svg aria-hidden=\"true\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></button></section>",
      "css": ".ds-group{color-scheme:light dark;font-family:\"DM Sans\",system-ui,sans-serif;color:light-dark(#0a0a0a, #fafafa);border:1px solid light-dark(#dfdfdf, #34312e);background:light-dark(#f4f4f4, #201e1c);border-radius:0.5rem;overflow:hidden}.ds-group-row{font-family:\"DM Sans\",system-ui,sans-serif;width:100%;display:flex;align-items:center;justify-content:space-between;gap:.5rem;text-align:left;border:0;padding:.75rem 1rem;background:transparent;color:inherit;font-size:.875rem}.ds-group-row+.ds-group-row{border-top:1px solid light-dark(#dfdfdf, #34312e)}.ds-group-copy{display:grid;gap:.25rem}.ds-group-copy small,.ds-group-row svg{color:light-dark(#606060, #aaa49e)}.ds-group-row:hover{background:light-dark(#eaeaea, #3a3632)}.ds-group-row:focus-visible{outline:2px solid light-dark(#0a0a0a, #d4d4d4);outline-offset:-2px}"
    },
    {
      "name": "Composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Tinted prompt surface with an embedded editor and its action row.",
      "html": "<section class=\"ds-composer\" aria-label=\"Composer\"><textarea class=\"ds-composer-editor\" aria-label=\"Message\" placeholder=\"Message\" rows=\"2\"></textarea><div class=\"ds-composer-actions\"><button class=\"ds-composer-model\">Codex⌄</button><button class=\"ds-composer-send\" aria-label=\"Send\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></button></div></section>",
      "css": ".ds-composer{color-scheme:light dark;font-family:\"DM Sans\",system-ui,sans-serif;color:light-dark(#0a0a0a, #fafafa);display:grid;gap:0.5rem;border:1px solid light-dark(#dfdfdf, #34312e);background:color-mix(in srgb,light-dark(#efefef, #2c2926) 55%,transparent);border-radius:0.75rem;padding:0.75rem}.ds-composer-editor{font-family:\"DM Sans\",system-ui,sans-serif;resize:none;border:0;background:transparent;color:inherit;font-size:.875rem}.ds-composer-editor::placeholder{color:light-dark(#606060, #aaa49e)}.ds-composer-actions{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.ds-composer-model{font-family:\"DM Sans\",system-ui,sans-serif;border-radius:6px;border:0;padding:.25rem .375rem;background:transparent;color:inherit}.ds-composer-model:hover{background:light-dark(#eaeaea, #3a3632)}.ds-composer-send{display:grid;place-items:center;width:2rem;height:2rem;padding:0;border:0;border-radius:999px;background:light-dark(#171717, #fafafa);color:light-dark(#fafafa, #171717)}.ds-composer-send:hover{background:light-dark(#262626, #e5e5e5)}.ds-composer-send:active{background:light-dark(#0a0a0a, #d4d4d4)}.ds-composer-model:focus-visible,.ds-composer-send:focus-visible,.ds-composer-editor:focus-visible{outline:2px solid light-dark(#0a0a0a, #d4d4d4);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "Quiet Workbench",
    "overview": "Huggler Desktop is quiet, compact, and direct. The conversation occupies the center, with task navigation on the left and files, changes, and traces on the right. The app uses subtle shifts in surface tone and compact controls to keep attention on the current task.\n\nMeaningful state gets a stronger signal. A primary action has a high-contrast fill, an active row has a tonal highlight, and an attention item pairs a colored icon with a label and a reason.",
    "keyCharacteristics": [
      "Neutral surfaces with warmer dark tones",
      "Compact DM Sans controls and readable transcript columns",
      "Status color paired with text or icon shape"
    ],
    "rules": [],
    "dos": [
      "Do reuse the theme roles so new desktop surfaces follow System, Light, and Dark.",
      "Do pair task status color with a recognizable icon or a readable label.",
      "Do keep the conversation usable as sidebars resize, collapse, or overlay it.",
      "Do preserve built-in focus handling when composing native controls."
    ],
    "donts": []
  }
}
