{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huggler",
  "version": "0.1.0",
  "identifier": "dev.huggler.stage2",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Huggler", "width": 780, "height": 640 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["app"] }
}
